# Copy to .env for local runs. Never commit .env.
# In GitHub Actions these come from repository secrets.

# GitHub token, read-only access to public repositories
GITHUB_TOKEN=

# AI summaries: provider is chosen in config, only the key you use is needed
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Neon Postgres: pipeline_rw role (daily jobs)
DATABASE_URL=
# Neon Postgres: owner role, used only by the manual migration workflow
DATABASE_URL_MIGRATE=

# Passphrase that encrypts the weekly pg_dump backup
BACKUP_PASSPHRASE=

# Cloudflare: deploy JSON to Pages, deploy the status Worker
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
